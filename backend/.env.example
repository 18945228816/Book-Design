# 应用配置
APP_NAME=读书感悟记录系统
APP_VERSION=1.0.0
DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=book_design

# JWT配置
SECRET_KEY=your-secret-key-here-change-it
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI配置
# 只填你真正有 Key 的供应商。留占位符会被播种成"空壳供应商"，
# 页面上看得到却调不通。AI_DEFAULT_PROVIDER 必须是下面配了 Key 的那一个。
AI_API_KEY=your-gateway-api-key
AI_API_BASE_URL=https://hk.xty.app/v1
AI_MODEL=gpt-3.5-turbo
AI_DEFAULT_PROVIDER=openai
AI_TASK_ROUTE_DEFAULT=openai,legacy
AI_TASK_ROUTE_TAG_GENERATION=openai,legacy
AI_TASK_ROUTE_MATERIAL_ANALYSIS=openai,legacy
AI_TASK_ROUTE_CHAT_COMPLETION=openai,legacy

# OpenAI 兼容接口（也可指向聚合网关）
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 以下为可选的厂商直连，不用就整段留空/删掉
# SENSENOVA_API_KEY=
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_TEXT_MODEL=deepseek-v4-flash
# SENSENOVA_IMAGE_MODEL=sensenova-u1-fast
# SENSENOVA_VISION_MODEL=sensenova-6.7-flash-lite

# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-5.1

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# 邮件发送（注册验证码）
# QQ邮箱：设置 → 账户 → POP3/IMAP/SMTP 服务 → 生成授权码（不是QQ登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM_NAME=读书感悟记录系统
CODE_EXPIRE_MINUTES=10
CODE_RESEND_SECONDS=60
